# Build stage
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

RUN npm run build:game-server

# Production stage
FROM node:22-alpine AS production

WORKDIR /app

ENV NODE_ENV=production

COPY package*.json ./

RUN npm ci --omit=dev

# Copy built application
COPY --from=builder /app/dist ./dist

EXPOSE 2567

CMD ["node", "dist/apps/game-server/apps/game-server/src/main"]
