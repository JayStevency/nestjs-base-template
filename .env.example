# App
APP_PORT=3000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nestjs
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nestjs?schema=public"

# Redis (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
